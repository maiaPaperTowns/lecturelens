# ---- Backend ----
# PostgreSQL connection (used by FastAPI + Alembic)
POSTGRES_USER=lenslab
POSTGRES_PASSWORD=lenslab
POSTGRES_DB=lecturelens
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://lenslab:lenslab@db:5432/lecturelens

# App
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api
MAX_UPLOAD_MB=25
UPLOAD_DIR=/data/uploads
MODELS_DIR=/models
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ML
EMBEDDING_DIM=128
CONCEPT_MODEL_VERSION=auto
DIFFICULTY_MODEL_VERSION=auto

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api
